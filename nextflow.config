manifest {
    name            = 'mini-rnaseq-nf'
    author          = 'Omar ELRHOUL'
    description     = 'Mini RNA-seq pipeline: QC, trimming, HISAT2 alignment, MultiQC'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.10.0'
}

process {
    cpus   = 1
    memory = 2.GB
}

profiles {
    docker {
        docker.enabled = true
    }
    test {
        params.input = "${projectDir}/data/samplesheet.csv"
        params.fasta = "${projectDir}/data/genome.fa"
    }
}
